{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "build",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "alwaysStrict": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
  "strictNullChecks": false,
  "typeRoots": ["./node_modules/@types"],
  },
  "include": [
    "src",
    "__tests__",
    "gateway",
    "services/catalog",
    "services/reviews",
    "services/users",
    "services/mal-integration"
  ]
}
